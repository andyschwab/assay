{
  "name": "assay",
  "version": "0.3.0",
  "description": "Evidence-based repository evaluation: a map of a repository, measured against a yardstick of requirements, written as four views of one run (Intake, Maintain, Improve and Owner) plus Since, of two.",
  "type": "module",
  "license": "Apache-2.0",
  "bin": { "assay": "assay.mjs" },
  "scripts": {
    "test": "node tests/regression.mjs",
    "lint": "node lib/check-syntax.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "build": "node lib/check-syntax.mjs",
    "assay": "node assay.mjs",
    "validate": "node assay.mjs validate",
    "score": "node assay.mjs score"
  },
  "engines": { "node": ">=20" },
  "devDependencies": { "@types/node": "20.19.43", "typescript": "5.9.3" }
}
