{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "target": "es2022",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "types": ["node"],
    "skipLibCheck": true
  },
  "include": ["*.mjs", "lib/**/*.mjs", "map/**/*.mjs", "owner/**/*.mjs", "routine/**/*.mjs", "views/**/*.mjs", "yardstick/**/*.mjs"]
}
